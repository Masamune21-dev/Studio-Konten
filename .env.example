# Salin file ini ke .env (cp .env.example .env), lalu isi. File .env tidak ikut git.
# Satu variabel per baris, tanpa komentar di belakang nilai.

# Wajib untuk narasi: Gemini TTS (gratis ±10 request/hari per model per project Google).
GEMINI_API_KEY=
# Opsional: key cadangan dari project Google lain (_2 sampai _9), dipakai saat key sebelumnya habis.
# GEMINI_API_KEY_2=

# Endpoint OpenAI-compatible (mis. 9router atau router lain) untuk ide, caption, terjemahan prompt
# gambar, posisi mulut (visi), dan cek suara (transkripsi audio). Bisa juga diisi di Pengaturan.
ROUTER_BASE_URL=
ROUTER_API_KEY=
# Model audio untuk npm run check dan fixcuts, dan model visi untuk posisi mulut (nama model di router kamu).
# CHECK_MODEL=ag/gemini-3.8-flash
# VISION_MODELS=ag/gemini-3.8-flash,gemini/gemini-3.8-flash

# Opsional: gambar karakter anime (Qwen-Image di Alibaba Cloud DashScope, region internasional).
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# Opsional: server TTS lama untuk script.json "engine" selain gemini.
# TTS_API_URL=

# Opsional: port dashboard (bawaan 4321).
# PORT=4321
